{
  "name": "lifenum-wuxing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "dev:cf": "npm run build && wrangler pages dev dist",
    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name lifenum --branch main",
    "db:migrate": "wrangler d1 migrations apply lifenum --remote",
    "db:migrate:local": "wrangler d1 migrations apply lifenum --local",
    "typecheck:api": "tsc -p functions/tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.7",
    "wrangler": "^4.151.2"
  }
}
